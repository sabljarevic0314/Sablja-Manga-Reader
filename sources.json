    {
      "id": "weebcentral",
      "name": "WeebCentral",
      "base_url": "https://weebcentral.com",
      "headers": {
        "HX-Request": "true"
      },
      "popular": {
        "url": "/search/data?limit=32&offset={offset}&sort=Popularity&order=Descending&official=Any&anime=Any&adult=Any&display_mode=Full%20Display",
        "item": "article.bg-base-300",
        "title": "a.link",
        "cover": "img"
      },
      "search": {
        "url": "/search/data?text={query}&limit=32&offset={offset}&sort=Best%20Match&order=Descending&official=Any&anime=Any&adult=Any&display_mode=Full%20Display",
        "item": "article.bg-base-300",
        "title": "a.link",
        "cover": "img"
      },
      "details": {
        "title": "h1",
        "description": "li:has(strong:-soup-contains(Description)) p",
        "cover": "img[alt$='cover']"
      },
      "chapters": {
        "item": "a[href*='/chapters/']",
        "list_path": "/full-chapter-list",
        "newest_first": true,
        "title_pattern": "^(.*?)(?:\\s+Last Read|\\s+\\d{4}-\\d{2}-\\d{2}T|$)"
      },
      "pages": {
        "image": "img[src^='http']",
        "url_suffix": "/images?is_prev=False&reading_style=long_strip"
      }
    },
